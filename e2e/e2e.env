# Throwaway configuration for local end-to-end runs (e2e/run.sh). Nothing here is a
# credential: every service is a disposable local process that run.sh starts and
# wipes. Never point this at a real database.
#
# Ports avoid Windows' reserved ranges -- 8000 is reserved on the dev machines this
# was built on, which is why the API is on 8010. `netsh interface ipv4 show
# excludedportrange protocol=tcp` lists them if one of these ever collides.
DB_URL=postgresql://postgres@127.0.0.1:5433/frogquiz
REDIS=redis://127.0.0.1:6380/0?decode_responses=True
MEILISEARCH_URL=http://127.0.0.1:7701
MEILISEARCH_INDEX=frogquiz_e2e
SECRET_KEY=e2e0123456789abcdef0123456789abcdef0123456789abcdef0123456789ab
ACCESS_TOKEN_EXPIRE_MINUTES=60
ROOT_ADDRESS=http://localhost:3000
# Vite's proxy rewrites Host to the API's address but leaves Origin as the dev
# server, so socket.io's same-origin check rejects every player (400 on polling
# POSTs, 403 on the WebSocket upgrade) unless the dev origin is listed.
CORS_ORIGINS=http://localhost:3000
SKIP_EMAIL_VERIFICATION=True
# Mail goes to e2e/mailsink.py, which run.sh starts and points MAIL_SERVER/MAIL_PORT at.
# Setting an address here is what makes `mail_configured` true, and so what makes
# /forgot-password answer at all rather than 503. Username and password stay empty:
# the backend only calls AUTH when both are set, and the sink takes no credentials.
MAIL_ADDRESS=noreply@frogquiz.test
MAIL_FROM_NAME=frogQuiz
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SECURITY=none
# The deliverability check is a live MX lookup; test addresses use example.com, which
# publishes a null MX and is rejected. Off so runs need no DNS.
VALIDATE_EMAIL_DELIVERABILITY=False
STORAGE_BACKEND=local
STORAGE_PATH=e2e/.data/storage
TELEMETRY_ENABLED=False
# Many simulated players and repeated logins would trip it.
RATE_LIMIT_ENABLED=False
