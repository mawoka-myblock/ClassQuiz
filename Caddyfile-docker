{$SITE_ADDRESS::8080} {
	reverse_proxy * http://frontend:3000
	reverse_proxy /api/* http://api:80
	reverse_proxy /openapi.json http://api:80 # Only use if you need to serve the OpenAPI spec
	reverse_proxy /socket.io/* api:80

	# Stop an oversized upload at the edge, before it reaches the API at all. The API
	# rejects on Content-Length too and then on the counted bytes, but by then Starlette
	# has spooled the body to a temp file. Keep this above the per-file ceiling in
	# frogquiz/config.py (max_image_upload_size) with room for the multipart framing.
	@upload path /api/v1/storage/*
	request_body @upload {
		max_size 10MB
	}
}
