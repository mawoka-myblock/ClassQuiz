# Throwaway configuration for the test suite, matching the services in
# docker-compose.dev.yml. Nothing here is a credential: the suite stubs the
# SMTP send, and every value points at a local container. Never point this at
# a real database or mail server -- run_tests.sh drops volumes and the tests
# create and delete users.
DB_URL=postgresql://postgres:mysecretpassword@127.0.0.1:5432/frogquiz
REDIS=redis://127.0.0.1:6379/0?decode_responses=True
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_INDEX=frogquiz_test
SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=30
ROOT_ADDRESS=http://127.0.0.1:8000
SKIP_EMAIL_VERIFICATION=True
MAIL_ADDRESS=test@example.com
MAIL_PASSWORD=unused-the-suite-stubs-the-smtp-send
MAIL_USERNAME=test
MAIL_SERVER=127.0.0.1
MAIL_PORT=587
STORAGE_BACKEND=local
STORAGE_PATH=/tmp/storage
TELEMETRY_ENABLED=False

# QuizTivity is disabled by default for the internal build (ENABLE_QUIZTIVITY in
# frogquiz/config.py). The suite turns it back on so the code stays covered for
# the day someone wants the feature, and so the flag itself is exercised.
ENABLE_QUIZTIVITY=True

# Same reasoning for ratings and WebAuthn (MVP.md D11). The testing routes are what the
# suite reads users back through; they are off everywhere else.
ENABLE_RATINGS=True
ENABLE_WEBAUTHN=True
ENABLE_TESTING_ROUTES=True

# The suite logs in far more often than a real client would.
RATE_LIMIT_ENABLED=False
